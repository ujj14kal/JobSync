# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Backend API ──────────────────────────────────────────────────────────────
# Local dev:       http://localhost:8000
# Production:      https://your-backend.up.railway.app   (Railway URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Groq (Free LLM) ─────────────────────────────────────────────────────────
# Free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# ─── Email (Resend — free tier, 3000 emails/month) ───────────────────────────
# Free key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars

# ─── CORS (backend) ───────────────────────────────────────────────────────────
# Local:       ["http://localhost:3000"]
# Production:  ["https://your-app.vercel.app"]
# Both:        ["http://localhost:3000","https://your-app.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Gmail Sync (Auto job status tracking) ────────────────────────────────────
# Client ID (same OAuth client used for Google sign-in)
GOOGLE_CLIENT_ID=329097420297-1vkhlbuo9igbalo7mj30vik5652dm16h.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret   # from Google Console → Credentials

# Local dev:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
FRONTEND_URL=http://localhost:3000

# Production (callback must hit the BACKEND Cloud Run URL, not Vercel):
# GOOGLE_REDIRECT_URI=https://jobsync-329097420297.asia-south1.run.app/api/v1/gmail/callback
# FRONTEND_URL=https://job-sync-gilt.vercel.app
