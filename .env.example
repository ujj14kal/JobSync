# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Backend API ──────────────────────────────────────────────────────────────
# Local dev:       http://localhost:8000
# Production:      https://your-backend.up.railway.app   (Railway URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Groq (Free LLM) ─────────────────────────────────────────────────────────
# Free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars

# ─── CORS (backend) ───────────────────────────────────────────────────────────
# Local:       ["http://localhost:3000"]
# Production:  ["https://your-app.vercel.app"]
# Both:        ["http://localhost:3000","https://your-app.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Gmail Sync (Auto job status tracking) ────────────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: http://localhost:8000/api/v1/gmail/callback
# 4. Enable Gmail API: APIs & Services → Enable APIs → search "Gmail API"
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
FRONTEND_URL=http://localhost:3000
