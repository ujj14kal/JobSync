# ─────────────────────────────────────────────────────────────────────────────
# JobSync — Local development environment
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
APP_VERSION=dev

# ── Supabase ──────────────────────────────────────────────────────────────────
# Production project (ap-south-1)
SUPABASE_URL=https://dzdziagugdcbkictslrt.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR6ZHppYWd1Z2RjYmtpY3RzbHJ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4NTcwMjYsImV4cCI6MjA5NTQzMzAyNn0.1nf7Um3PDSZMzHaBmf2bIzgEqzwpClEp1i_leRnLBYE
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq (free LLM) ───────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ── Local Ollama (optional — for zero-cost local inference) ───────────────────
# Leave blank to use Groq only
# Setup: brew install ollama && ollama pull llama3.2:3b-instruct-q8_0
OLLAMA_BASE_URL=http://localhost:11434

# ── Resend (transactional emails — payment receipts, pro activation) ──────────
# Free tier: 3,000 emails/month. Get from: https://resend.com/api-keys
# Leave blank to skip emails (safe for local dev)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Razorpay (Indian payments) ────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here
# Plan IDs — create once in Razorpay dashboard (₹299/month, ₹2499/year)
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx

# ── Google OAuth (Gmail sync feature) ─────────────────────────────────────────
# Get from: Google Cloud Console → APIs → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ── ElevenLabs (AI voice interviews — optional) ───────────────────────────────
# Required only for the paid voice interview feature
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic Claude (Pro tier AI feedback — optional) ────────────────────────
# Required only for Pro users' Claude-powered resume rewrites
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
